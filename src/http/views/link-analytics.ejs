<%- include('partials/shell-open', { title, csrfToken, user, active: 'links' }) %>
    <div class="page-header">
      <div>
        <h1><%= link.title || link.code %></h1>
        <p class="muted mt-sm">
          <span class="short-link">
            <%= appBaseUrl.replace(/^https?:\/\//, '') %>/<%= link.code %>
            <button type="button" class="link-button icon-only" data-copy="<%= appBaseUrl %>/<%= link.code %>" title="Kopyala" aria-label="Kopyala">
              <svg class="icon" aria-hidden="true"><use href="#icon-copy"></use></svg>
            </button>
          </span>
          → <%= link.targetUrl %>
        </p>
      </div>
      <a class="button secondary" href="/panel">← Bağlantılarım</a>
    </div>

    <div class="stat-cards">
      <div class="stat-card">
        <div class="stat-value"><%= overview.totalClicks %></div>
        <div class="stat-label">Toplam tıklama (bot hariç, son 30 gün)</div>
      </div>
      <div class="stat-card">
        <div class="stat-value"><%= overview.totalBotClicks %></div>
        <div class="stat-label">Bot/önizleme isteği</div>
      </div>
      <div class="stat-card">
        <div class="stat-value">
          <%= overview.firstClickAt ? overview.firstClickAt.toISOString().replace('T',' ').slice(0,16) : '—' %>
        </div>
        <div class="stat-label">İlk tıklama zamanı</div>
      </div>
    </div>

    <h2>Günlük tıklama</h2>
    <div class="table-wrap">
    <table class="data-table">
      <thead><tr><th>Tarih</th><th>Tıklama</th></tr></thead>
      <tbody>
        <% overview.timeSeries.forEach((row) => { %>
        <tr><td><%= row.date %></td><td><%= row.count %></td></tr>
        <% }) %>
        <% if (overview.timeSeries.length === 0) { %>
        <tr><td colspan="2" class="muted">Henüz veri yok.</td></tr>
        <% } %>
      </tbody>
    </table>
    </div>

    <h2>Ülkeye göre</h2>
    <div class="table-wrap">
    <table class="data-table">
      <thead><tr><th>Ülke</th><th>Tıklama</th></tr></thead>
      <tbody>
        <% overview.byCountry.forEach((row) => { %>
        <tr><td><%= row.country || 'Bilinmiyor' %></td><td><%= row.count %></td></tr>
        <% }) %>
        <% if (overview.byCountry.length === 0) { %>
        <tr><td colspan="2" class="muted">Henüz veri yok.</td></tr>
        <% } %>
      </tbody>
    </table>
    </div>

    <h2>Cihaz / İşletim Sistemi / Tarayıcı</h2>
    <div class="stat-cards">
      <div class="table-wrap flex-1">
      <table class="data-table">
        <thead><tr><th>Cihaz</th><th>Tıklama</th></tr></thead>
        <tbody>
          <% overview.byDevice.forEach((row) => { %>
          <tr><td><%= row.label %></td><td><%= row.count %></td></tr>
          <% }) %>
        </tbody>
      </table>
      </div>
      <div class="table-wrap flex-1">
      <table class="data-table">
        <thead><tr><th>İşletim Sistemi</th><th>Tıklama</th></tr></thead>
        <tbody>
          <% overview.byOs.forEach((row) => { %>
          <tr><td><%= row.label %></td><td><%= row.count %></td></tr>
          <% }) %>
        </tbody>
      </table>
      </div>
      <div class="table-wrap flex-1">
      <table class="data-table">
        <thead><tr><th>Tarayıcı</th><th>Tıklama</th></tr></thead>
        <tbody>
          <% overview.byBrowser.forEach((row) => { %>
          <tr><td><%= row.label %></td><td><%= row.count %></td></tr>
          <% }) %>
        </tbody>
      </table>
      </div>
    </div>
<%- include('partials/shell-close') %>
