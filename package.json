{
  "name": "url-kisaltma-platformu",
  "version": "1.0.0",
  "private": true,
  "description": "Kurumsal ic kullanim icin kapali URL kisaltma platformu",
  "type": "commonjs",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "stop": "sh stop.sh",
    "lint": "node scripts/lint.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "postinstall": "node -e \"require('better-sqlite3')\"",
    "job:rollup": "node src/jobs/dailyRollup.js",
    "job:cleanup-sessions": "node src/jobs/cleanupSessions.js",
    "job:archive-clicks": "node src/jobs/archiveClicks.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "11.10.0",
    "cookie": "^1.0.2",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "lru-cache": "10.4.3",
    "qrcode": "^1.5.4",
    "ua-parser-js": "^1.0.39"
  },
  "optionalDependencies": {
    "ioredis": "^5.4.1"
  },
  "allowScripts": {
    "better-sqlite3": true
  },
  "engines": {
    "node": ">=18.20.0"
  }
}
