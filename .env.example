# Ortam: development | production
NODE_ENV=development

# Opsiyonel - cPanel/Plesk (Passenger) gibi paylasimli hosting ortamlari PORT'u
# kendisi enjekte eder; orada bu satiri hic eklemeyin. Yerel gelistirmede
# belirtilmezse 3000 kullanilir.
PORT=3000

# Yonlendirme baglantilari bu taban URL uzerinden uretilir (protokol dahil, sonunda / olmadan)
APP_BASE_URL=http://localhost:3000

# Onbellek / kuyruk / oran-sinirlayici surucusu: memory (demo) | redis (uretim)
# Uygulama kodu bu satir disinda hicbir yerde degismez.
CACHE_DRIVER=memory

# SQLite dosya yolu. `file:` oneki istege baglidir; relatif yollar proje kokune gore cozulur.
DATABASE_URL="file:./data/dev.db"

# CACHE_DRIVER=redis oldugunda zorunludur
REDIS_URL=

# Oturum cerezini imzalamak icin kullanilir - en az 32 rastgele karakter, asla paylasilmaz
SESSION_SECRET=degistir-en-az-32-karakter-rastgele-bir-deger

# CSRF token'lari turetmek icin kullanilir - SESSION_SECRET'tan farkli olmali
CSRF_SECRET=degistir-en-az-32-karakter-farkli-bir-deger

# Ham IP adresini hashlemeden once tuzlamak icin kullanilir (KVKK) - duzenli araliklarla dondurulmeli
IP_HASH_SALT=degistir-en-az-32-karakter-uculcu-bir-deger

# true ise oturum cerezi Secure bayragiyla ve __Host- onekiyle set edilir (HTTPS zorunlu kilar)
# Uretimde her zaman true olmali. Yerel http gelistirmede false birakilabilir.
COOKIE_SECURE=false

# Tiklama ham kayitlarinin (click_events) kac gun sonra arsivlenecegi/silinecegi
CLICK_RETENTION_DAYS=90

# BufferedSink'in tiklama olaylarini veritabanina bosaltma araligi (ms)
SINK_FLUSH_INTERVAL_MS=5000

# Seed script'i ile olusturulacak ilk admin hesabi (yalnizca ilk kurulumda kullanilir)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=DegistirBu123!

# Terminal/SSH yoksa /setup/bootstrap ve /setup/create-admin icin. Bos ise uc noktalar kapali.
# Ilk kurulumdan sonra kaldirin.
SETUP_TOKEN=
